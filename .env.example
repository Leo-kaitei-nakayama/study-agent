ANTHROPIC_API_KEY=sk-ant-xxxxx
# CLAUDE_MODEL=claude-sonnet-4-6

# --- webapp 用 ---------------------------------------------------------
# Supabase の Connection string (Project Settings → Database)
DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres
# Flask のセッション署名鍵: python3 -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET_KEY=
# 外部サイトのパスワードを暗号化する鍵。DB とは別の場所に置くこと。
# 生成: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ※ この鍵を失うと、保存済みのサイトパスワードは復号できなくなる(再入力が必要)
CREDENTIAL_KEY=
