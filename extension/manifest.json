{
  "manifest_version": 3,
  "name": "Study Agent Canvas Sync",
  "version": "0.3.0",
  "description": "Syncs your Canvas courses, syllabi, rubrics and weekly modules, drafts answers for practice questions, and can explain a screenshot of a page. Opt-in; never submits anything.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://canvas.eee.uci.edu/*",
    "https://study-agent-500j.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://study-agent-500j.onrender.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://canvas.eee.uci.edu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Study Agent"
  }
}
